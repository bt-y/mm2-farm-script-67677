task.spawn(function()
    while true do
        if ACTIVE then
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then
                local closest, dist = nil, math.huge
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Name == "Coin_Server" and not visited[obj] then
                        local d = (obj.Position - root.Position).Magnitude
                        if d < dist and d < RANGE then
                            closest, dist = obj, d
                        end
                    end
                end
                if closest then
                    local tween = TweenService:Create(root, TweenInfo.new(dist / SPEED, Enum.EasingStyle.Linear), {CFrame = CFrame.new(closest.Position)})
                    tween:Play()
                    tween.Completed:Wait()
                    if closest and closest.Parent then
                        visited[closest] = true
                        collected += 1
                        lastCollectedTime = tick()
                        inactivitySent = false
                        counter.Text = "Collected: " .. collected
                    end
                end
            end
            task.wait(0.08)
        else
            task.wait(0.5)
        end
    end
end)
